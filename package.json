{
  "name": "idea-git-log",
  "displayName": "IDEA Git Log",
  "description": "A focused Git log view with branches, commit graph, and commit details. No AI features.",
  "version": "0.0.27",
  "publisher": "petrichoral",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Petrichor-Dusk/idea-git-log.git"
  },
  "engines": {
    "vscode": "^1.104.3"
  },
  "extensionDependencies": [
    "vscode-icons-team.vscode-icons"
  ],
  "categories": [
    "SCM Providers"
  ],
  "main": "./src/extension.js",
  "dependencies": {
    "@vscode/codicons": "0.0.45"
  },
  "activationEvents": [
    "onCommand:ideaGitLog.open",
    "onView:ideaGitLog.sidebarView"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ideaGitLog.open",
        "title": "Git Log: Open"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ideaGitLog.activityBar",
          "title": "Git Log",
          "icon": "resources/git-log.svg"
        }
      ]
    },
    "views": {
      "ideaGitLog.activityBar": [
        {
          "id": "ideaGitLog.sidebarView",
          "name": "Git Log",
          "type": "webview"
        }
      ]
    }
  }
}
